# ============================================================
# Vibe Kanban — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# ============================================================

# ── PostgreSQL ──
POSTGRES_PASSWORD=changeme_pg_password

# ── Pre-built Database URLs ──
# IMPORTANT: URL-encode special chars in password (+=%2B, /=%2F, @=%40)
SERVER_DATABASE_URL=postgresql://remote:changeme_pg_password@db:5432/remote
ELECTRIC_DATABASE_URL=postgresql://electric_sync:changeme_pg_password@db:5432/remote
ELECTRIC_ROLE_PASSWORD=changeme_electric_password

# ── Authentication ──
VIBEKANBAN_REMOTE_JWT_SECRET=changeme_jwt_secret_at_least_32_chars
SELF_HOST_LOCAL_AUTH_EMAIL=admin@example.com
SELF_HOST_LOCAL_AUTH_PASSWORD=changeme_admin_password

# ── LLM API Keys ──
MINIMAX_API_KEY=

# ── Public URLs (for Cloudflare tunnel or reverse proxy) ──
PUBLIC_BASE_URL=http://localhost:8081
RELAY_PUBLIC_URL=http://localhost:8082

# ── Cloudflare Tunnel (optional) ──
CF_TUNNEL_TOKEN=

# ── OpenChamber ──
OPENCHAMBER_UI_PASSWORD=lemon0116

# ── MCP Service ──
MCP_AUTH_TOKEN=6325ad639d4722df2e2eddb2f53e5fcd53d243fa0675ad103ca255a354f26dea

# ── Port Overrides (optional) ──
# HOST_PORT=3000
# REMOTE_PORT=8081
# OPENCHAMBER_PORT=3080
# MCP_ADMIN_PORT=8080
# MCP_SSE_PORT=8000
