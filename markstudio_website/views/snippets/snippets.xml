<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<!-- 在 Website Builder 的 snippet 面板註冊 O.G老地方 區塊群組 -->
<template id="snippets" inherit_id="website.snippets" name="OG Snippets">
    <xpath expr="//t[@id='installed_snippets_hook']" position="after">
        <t snippet-group="og_bodywork"
           t-snippet="website.s_snippet_group"
           string="O.G老地方"
           t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
    </xpath>

    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="markstudio_website.s_og_hero" string="OG Hero" group="og_bodywork">
            <keywords>hero, banner, OG, 首頁, 橫幅, 老地方</keywords>
        </t>
        <t t-snippet="markstudio_website.s_og_story" string="OG 品牌故事" group="og_bodywork">
            <keywords>story, brand, 品牌故事, why, OG</keywords>
        </t>
        <t t-snippet="markstudio_website.s_og_services" string="OG 服務" group="og_bodywork">
            <keywords>services, 服務, 關節, 筋膜, IASTM</keywords>
        </t>
        <t t-snippet="markstudio_website.s_og_flow" string="OG 流程" group="og_bodywork">
            <keywords>flow, steps, 流程, 步驟, 修復</keywords>
        </t>
        <t t-snippet="markstudio_website.s_og_booking" string="OG 預約" group="og_bodywork">
            <keywords>booking, appointment, 預約, CTA</keywords>
        </t>
        <t t-snippet="markstudio_website.s_og_contact" string="OG 聯繫" group="og_bodywork">
            <keywords>contact, email, phone, 聯繫, 地址</keywords>
        </t>
    </xpath>
</template>
</data></odoo>
