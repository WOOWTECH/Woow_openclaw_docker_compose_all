<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<!-- 在 Website Builder 的 snippet 面板註冊 Mark Studio 區塊群組 -->
<template id="snippets" inherit_id="website.snippets" name="Mark Studio Snippets">
    <xpath expr="//t[@id='installed_snippets_hook']" position="after">
        <t snippet-group="markstudio"
           t-snippet="website.s_snippet_group"
           string="Mark Studio"
           t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
    </xpath>

    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="markstudio_website.s_mk_hero" string="MK Hero" group="markstudio">
            <keywords>hero, banner, mark studio, 首頁, 橫幅</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_stats" string="MK 數據" group="markstudio">
            <keywords>statistics, numbers, 數據, 統計</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_services" string="MK 服務" group="markstudio">
            <keywords>services, 服務, massage, stretch</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_technique" string="MK 技術" group="markstudio">
            <keywords>technique, core balance stretch, 技術</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_experience" string="MK 流程" group="markstudio">
            <keywords>experience, steps, 流程, 步驟</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_booking" string="MK 預約" group="markstudio">
            <keywords>booking, appointment, 預約, CTA</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_news" string="MK 最新消息" group="markstudio">
            <keywords>news, social, instagram, facebook, youtube, 最新消息</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_faq" string="MK 常見問題" group="markstudio">
            <keywords>faq, questions, 常見問題, FAQ</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_contact" string="MK 聯繫" group="markstudio">
            <keywords>contact, email, phone, 聯繫</keywords>
        </t>
    </xpath>
</template>
</data></odoo>
