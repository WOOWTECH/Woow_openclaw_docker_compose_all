<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="import_pos_order_wizard_form" model="ir.ui.view">
            <field name="name">import.pos.order.wizard.form</field>
            <field name="model">import.pos.order.wizard</field>
            <field name="arch" type="xml">
                <form string="匯入 POS 訂單">
                    <group>
                        <group string="出貨門市">
                            <field name="pos_config_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="檔案設定">
                            <field name="import_type" widget="radio"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="匯入選項">
                            <field name="product_by" widget="radio"/>
                            <field name="error_mode" widget="radio"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/> 訂單將使用<b>客戶帳戶</b>（先出貨後收款）付款方式建立。庫存將從所選門市的倉庫扣除。
                    </div>
                    <div class="mt-2 mb-2 d-flex gap-3">
                        <button name="action_download_sample_csv"
                                type="object"
                                string="下載 CSV 範本"
                                class="btn-link"
                                icon="fa-download"/>
                        <button name="action_download_sample_xlsx"
                                type="object"
                                string="下載 Excel 範本"
                                class="btn-link"
                                icon="fa-download"/>
                    </div>
                    <footer>
                        <button name="action_import"
                                type="object"
                                string="匯入"
                                class="btn-primary"/>
                        <button string="取消" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_import_pos_order_wizard" model="ir.actions.act_window">
            <field name="name">匯入 POS 訂單</field>
            <field name="res_model">import.pos.order.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
