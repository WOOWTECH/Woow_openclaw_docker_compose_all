<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 最新消息 Page Template                                        -->
    <!-- Social media feed embeds: Instagram, Facebook, YouTube       -->
    <!-- ============================================================ -->
    <template id="news_page" name="最新消息">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'news'"/>

            <!-- Hero Banner -->
            <section class="s_text_block pt48 pb32 o_colored_level"
                     style="background-color: #2c2c2c;">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12 text-center">
                            <h1 class="display-4" style="color: #fff;">最新消息</h1>
                            <p class="lead" style="color: #ccc;">
                                關注我們的社群媒體，掌握最新動態與優惠資訊
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Social Media Section -->
            <section class="s_text_block pt32 pb32">
                <div class="container">

                    <!-- Instagram Section -->
                    <div class="row mb-5">
                        <div class="col-lg-12">
                            <div class="d-flex align-items-center mb-4">
                                <span class="markstudio-social-icon markstudio-ig me-3">
                                    <i class="fa fa-instagram fa-2x"/>
                                </span>
                                <h2 class="mb-0">Instagram</h2>
                            </div>
                            <div class="markstudio-social-grid" id="instagram-feed">
                                <!-- Instagram embed placeholder -->
                                <!-- Replace with actual Instagram embed or API feed -->
                                <div class="markstudio-social-placeholder text-center p-5"
                                     style="background: #fafafa; border-radius: 12px; border: 2px dashed #dbdbdb;">
                                    <i class="fa fa-instagram fa-4x mb-3" style="color: #E1306C;"/>
                                    <p class="text-muted mb-2">Instagram 動態將顯示於此</p>
                                    <a href="#" class="btn btn-outline-dark btn-sm"
                                       target="_blank" rel="noopener noreferrer">
                                        <i class="fa fa-external-link me-1"/> 前往 Instagram
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4"/>

                    <!-- Facebook Section -->
                    <div class="row mb-5">
                        <div class="col-lg-12">
                            <div class="d-flex align-items-center mb-4">
                                <span class="markstudio-social-icon markstudio-fb me-3">
                                    <i class="fa fa-facebook fa-2x"/>
                                </span>
                                <h2 class="mb-0">Facebook</h2>
                            </div>
                            <div class="markstudio-social-grid" id="facebook-feed">
                                <!-- Facebook Page Plugin embed placeholder -->
                                <!-- Replace href with actual Facebook page URL -->
                                <div class="markstudio-social-placeholder text-center p-5"
                                     style="background: #fafafa; border-radius: 12px; border: 2px dashed #dbdbdb;">
                                    <i class="fa fa-facebook-square fa-4x mb-3" style="color: #1877F2;"/>
                                    <p class="text-muted mb-2">Facebook 粉絲專頁動態將顯示於此</p>
                                    <a href="#" class="btn btn-outline-primary btn-sm"
                                       target="_blank" rel="noopener noreferrer">
                                        <i class="fa fa-external-link me-1"/> 前往 Facebook
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4"/>

                    <!-- YouTube Section -->
                    <div class="row mb-5">
                        <div class="col-lg-12">
                            <div class="d-flex align-items-center mb-4">
                                <span class="markstudio-social-icon markstudio-yt me-3">
                                    <i class="fa fa-youtube-play fa-2x"/>
                                </span>
                                <h2 class="mb-0">YouTube</h2>
                            </div>
                            <div class="row" id="youtube-feed">
                                <!-- YouTube video embed placeholders -->
                                <!-- Replace src with actual YouTube embed URLs -->
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="markstudio-video-card">
                                        <div class="ratio ratio-16x9">
                                            <div class="markstudio-social-placeholder d-flex align-items-center justify-content-center"
                                                 style="background: #fafafa; border-radius: 8px; border: 2px dashed #dbdbdb;">
                                                <i class="fa fa-youtube-play fa-3x" style="color: #FF0000;"/>
                                            </div>
                                        </div>
                                        <p class="mt-2 text-muted small">影片標題 1</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="markstudio-video-card">
                                        <div class="ratio ratio-16x9">
                                            <div class="markstudio-social-placeholder d-flex align-items-center justify-content-center"
                                                 style="background: #fafafa; border-radius: 8px; border: 2px dashed #dbdbdb;">
                                                <i class="fa fa-youtube-play fa-3x" style="color: #FF0000;"/>
                                            </div>
                                        </div>
                                        <p class="mt-2 text-muted small">影片標題 2</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="markstudio-video-card">
                                        <div class="ratio ratio-16x9">
                                            <div class="markstudio-social-placeholder d-flex align-items-center justify-content-center"
                                                 style="background: #fafafa; border-radius: 8px; border: 2px dashed #dbdbdb;">
                                                <i class="fa fa-youtube-play fa-3x" style="color: #FF0000;"/>
                                            </div>
                                        </div>
                                        <p class="mt-2 text-muted small">影片標題 3</p>
                                    </div>
                                </div>
                            </div>
                            <div class="text-center">
                                <a href="#" class="btn btn-outline-danger btn-sm"
                                   target="_blank" rel="noopener noreferrer">
                                    <i class="fa fa-youtube-play me-1"/> 前往 YouTube 頻道
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

        </t>
    </template>

</odoo>
