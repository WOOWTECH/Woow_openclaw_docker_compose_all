<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<template id="s_og_flow" name="OG Flow">
    <section id="flow" class="og-flow" data-snippet="s_og_flow" data-name="OG 修復流程">
        <div class="container">
            <div class="og-accent-line"/>
            <h2 class="og-section-title-en">HOW IT WORKS</h2>
            <div class="og-flow-steps">
                <div class="og-flow-step">
                    <span class="og-flow-num">01</span>
                    <h3 class="og-flow-title">身體評估</h3>
                    <p class="og-flow-desc">了解你的身體歷史、疼痛模式與日常習慣</p>
                </div>
                <div class="og-flow-step">
                    <span class="og-flow-num">02</span>
                    <h3 class="og-flow-title">問題定位</h3>
                    <p class="og-flow-desc">透過動作測試與觸診，精準找出失衡根源</p>
                </div>
                <div class="og-flow-step">
                    <span class="og-flow-num">03</span>
                    <h3 class="og-flow-title">手技修復</h3>
                    <p class="og-flow-desc">針對問題源頭，逐層鬆解、調校、還原</p>
                </div>
                <div class="og-flow-step">
                    <span class="og-flow-num">04</span>
                    <h3 class="og-flow-title">維護建議</h3>
                    <p class="og-flow-desc">給你帶得走的修復知識，延續調校效果</p>
                </div>
            </div>
        </div>
    </section>
</template>
</data></odoo>
