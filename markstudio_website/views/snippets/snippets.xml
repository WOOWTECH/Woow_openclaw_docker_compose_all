<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<!-- 在 Website Builder 的 snippet 面板註冊 O.G老地方 區塊群組 -->
<template id="snippets" inherit_id="website.snippets" name="O.G老地方 Snippets">
    <xpath expr="//t[@id='installed_snippets_hook']" position="after">
        <t snippet-group="markstudio"
           t-snippet="website.s_snippet_group"
           string="O.G老地方"
           t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
    </xpath>

    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="markstudio_website.s_mk_hero" string="OG Hero" group="markstudio">
            <keywords>hero, banner, OG, 老地方, 首頁, 橫幅</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_stats" string="OG 數據" group="markstudio">
            <keywords>statistics, numbers, 數據, 統計</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_services" string="OG 服務" group="markstudio">
            <keywords>services, 服務, 關節鬆動, 筋膜, IASTM</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_technique" string="OG 理念" group="markstudio">
            <keywords>technique, 修復理念, 身體修復, why OG</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_experience" string="OG 流程" group="markstudio">
            <keywords>experience, restoration, 流程, 步驟, 修復</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_booking" string="OG 預約" group="markstudio">
            <keywords>booking, appointment, 預約, CTA, 身體修復</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_news" string="OG 最新消息" group="markstudio">
            <keywords>news, social, instagram, facebook, youtube, 最新消息</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_faq" string="OG 常見問題" group="markstudio">
            <keywords>faq, questions, 常見問題, FAQ, 身體修復</keywords>
        </t>
        <t t-snippet="markstudio_website.s_mk_contact" string="OG 聯繫" group="markstudio">
            <keywords>contact, 地址, 聯繫, 長安西路</keywords>
        </t>
    </xpath>
</template>
</data></odoo>
