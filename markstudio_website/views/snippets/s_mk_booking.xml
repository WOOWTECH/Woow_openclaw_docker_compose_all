<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<template id="s_mk_booking" name="MK Booking CTA">
    <section id="booking" class="mk-booking-cta" data-snippet="s_mk_booking" data-name="MK 預約區塊">
        <div class="container position-relative">
            <h2 class="mk-big-serif" style="color: var(--mk-white);">Ready to Feel Better?</h2>
            <p class="mk-booking-sub text-center">預約您的第一次伸展體驗，感受身體的改變</p>
            <div class="mk-booking-card">
                <div class="mk-booking-card-img">
                    <img src="/markstudio_website/static/src/img/svc-01-massage.jpg?v=3" alt="專業按摩伸展"/>
                </div>
                <div class="mk-booking-card-body">
                    <h3 class="mk-booking-card-title">專業按摩伸展</h3>
                    <div class="mk-booking-card-meta">
                        <span><i class="fa fa-clock-o"/> 60 分鐘</span>
                        <span><i class="fa fa-user"/> 馬克</span>
                        <span><i class="fa fa-tag"/> 免費體驗</span>
