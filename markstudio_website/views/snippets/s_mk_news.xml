<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<template id="s_mk_news" name="OG News Social">
    <section id="news" class="mk-news" data-snippet="s_mk_news" data-name="OG 最新消息">
        <div class="container">
            <h2 class="mk-sec-title">最新消息</h2>
            <div class="mk-sec-line"/>
            <p class="mk-news-sub">關注 O.G 老地方的社群媒體，掌握最新動態與修復知識</p>

            <div class="mk-social-block">
                <div class="d-flex align-items-center mb-4">
                    <span class="markstudio-social-icon markstudio-ig me-3"><i class="fa fa-instagram fa-2x"/></span>
                    <h3 class="mk-social-heading mb-0">Instagram</h3>
                </div>
                <div class="mk-social-placeholder text-center p-5">
                    <i class="fa fa-instagram fa-4x mb-3" style="color: #E1306C;"/>
                    <p class="mb-2">Instagram 動態將顯示於此</p>
                    <a href="#" class="mk-social-link" target="_blank" rel="noopener noreferrer"><i class="fa fa-external-link me-1"/> 前往 Instagram</a>
                </div>
            </div>

            <div class="mk-social-block">
                <div class="d-flex align-items-center mb-4">
                    <span class="markstudio-social-icon markstudio-fb me-3"><i class="fa fa-facebook fa-2x"/></span>
                    <h3 class="mk-social-heading mb-0">Facebook</h3>
                </div>
                <div class="mk-social-placeholder text-center p-5">
                    <i class="fa fa-facebook-square fa-4x mb-3" style="color: #1877F2;"/>
                    <p class="mb-2">Facebook 粉絲專頁動態將顯示於此</p>
                    <a href="#" class="mk-social-link" target="_blank" rel="noopener noreferrer"><i class="fa fa-external-link me-1"/> 前往 Facebook</a>
                </div>
            </div>

            <div class="mk-social-block">
                <div class="d-flex align-items-center mb-4">
                    <span class="markstudio-social-icon markstudio-yt me-3"><i class="fa fa-youtube-play fa-2x"/></span>
                    <h3 class="mk-social-heading mb-0">YouTube</h3>
                </div>
                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="markstudio-video-card">
                            <div class="ratio ratio-16x9"><div class="mk-social-placeholder d-flex align-items-center justify-content-center"><i class="fa fa-youtube-play fa-3x" style="color: #FF0000;"/></div></div>
                            <p class="mt-2 small" style="color: #bbb;">影片標題 1</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="markstudio-video-card">
                            <div class="ratio ratio-16x9"><div class="mk-social-placeholder d-flex align-items-center justify-content-center"><i class="fa fa-youtube-play fa-3x" style="color: #FF0000;"/></div></div>
                            <p class="mt-2 small" style="color: #bbb;">影片標題 2</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="markstudio-video-card">
                            <div class="ratio ratio-16x9"><div class="mk-social-placeholder d-flex align-items-center justify-content-center"><i class="fa fa-youtube-play fa-3x" style="color: #FF0000;"/></div></div>
                            <p class="mt-2 small" style="color: #bbb;">影片標題 3</p>
                        </div>
                    </div>
                </div>
                <div class="text-center">
                    <a href="#" class="mk-social-link" target="_blank" rel="noopener noreferrer"><i class="fa fa-youtube-play me-1"/> 前往 YouTube 頻道</a>
                </div>
            </div>
        </div>
    </section>
</template>
</data></odoo>
