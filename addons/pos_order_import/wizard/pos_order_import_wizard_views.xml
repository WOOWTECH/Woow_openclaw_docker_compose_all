<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="import_pos_order_wizard_form" model="ir.ui.view">
            <field name="name">import.pos.order.wizard.form</field>
            <field name="model">import.pos.order.wizard</field>
            <field name="arch" type="xml">
                <form string="Import POS Orders">
                    <group>
                        <group string="POS Store">
                            <field name="pos_config_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="File Settings">
                            <field name="import_type" widget="radio"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="Import Options">
                            <field name="product_by" widget="radio"/>
                            <field name="error_mode" widget="radio"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/> Orders will be created with <b>Customer Account</b> (pay later) payment method.
                        Stock will be deducted from the selected store's warehouse.
                    </div>
                    <div class="mt-2 mb-2">
                        <button name="action_download_sample_csv"
                                type="object"
                                string="Download CSV Template"
                                class="btn-link"
                                icon="fa-download"/>
                        <button name="action_download_sample_xlsx"
                                type="object"
                                string="Download Excel Template"
                                class="btn-link ms-3"
                                icon="fa-download"/>
                    </div>
                    <footer>
                        <button name="action_import"
                                type="object"
                                string="Import"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_import_pos_order_wizard" model="ir.actions.act_window">
            <field name="name">Import POS Orders</field>
            <field name="res_model">import.pos.order.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
