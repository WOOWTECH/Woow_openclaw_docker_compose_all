<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inject Google Fonts globally so appointment pages get them too -->
    <template id="markstudio_google_fonts"
              inherit_id="website.layout"
              name="Mark Studio Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&amp;family=Noto+Sans+TC:wght@300;400;500;700&amp;display=swap" rel="stylesheet"/>
            <!-- Prevent white flash on appointment pages: inject class before render -->
            <script>
                (function(){
                    var p = location.pathname.replace(/^\/en/, '');
                    if (p.indexOf('/appointment') === 0) {
                        document.documentElement.classList.add('mk-appointment-page');
                    }
                })();
            </script>
        </xpath>
    </template>

</odoo>
