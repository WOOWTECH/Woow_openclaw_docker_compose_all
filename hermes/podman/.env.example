# =============================================================
# Hermes Podman Stack — 環境變數
# =============================================================
# 複製後編輯: cp .env.example .env

# LLM Provider (MiniMax Token Plan — 使用 sk-cp- prefix)
MINIMAX_API_KEY=sk-cp-your-key-here

# API Server Key (自動生成: openssl rand -hex 32)
API_SERVER_KEY=

# WebUI 登入密碼
WEBUI_PASSWORD=admin

# PostgreSQL 密碼 (自動生成: openssl rand -base64 24 | tr -d '/+=' | head -c 24)
POSTGRES_PASSWORD=

# Host user UID/GID (查詢: id -u && id -g)
HERMES_UID=1000
HERMES_GID=1000
